; Projeto Godot 4 (C#). Ajuste config/features se sua engine for outra versão.

config_version=5

[application]

config/name="CookingSystem"
run/main_scene="res://Scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[display]

; 1600×900 é a tela de referência: o painel manual tem 1180 px de largura e precisa de folga.
; canvas_items + expand escala a interface inteira para outras resoluções sem cortar nada.
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="CookingSystem"

[input]

; Ações do painel de contexto. Teclado e controle são caminhos iguais: nada aqui
; existe só num dos dois. Confirmar e fechar ficam fora do grafo de foco.

panel_region_next={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194306,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":10,"pressure":0.0,"pressed":false,"script":null)]
}
